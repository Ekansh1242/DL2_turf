OPENAI_API_KEY=sk-...
JWT_SECRET=dev-secret-change-me
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/campussphere
REDIS_URL=redis://localhost:6379/0

# Email (booking confirmation + PDF receipt). Optional for local dev --
# if these aren't set, booking still succeeds, email is just skipped.
# For Gmail: use an "app password", not your real password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com

BOOKING_NLU_BACKEND=local
