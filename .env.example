OPENAI_API_KEY=
JWT_SECRET=
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/campussphere
REDIS_URL=redis://localhost:6379/0

# Email (booking confirmation + PDF receipt). Optional for local dev --
# if these aren't set, booking still succeeds, email is just skipped.
# For Gmail: use an "app password", not your real password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com

# local = trained BiLSTM extraction, llm = original OpenAI extraction
BOOKING_NLU_BACKEND=local
# Model checkpoint is resolved automatically from backend/ml/artifacts.

# Comma-separated real inboxes allowed staff access AFTER email OTP verification.
ADMIN_EMAILS=ekanshb1242@gmail.com
ALLOWED_EMAIL_DOMAINS=rknec.edu
ANALYTICS_BACKEND=local
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
